# Database: SQLite works immediately. Swap to PostgreSQL in production.
DATABASE_URL=sqlite:///./jobs.db
# Example PostgreSQL:
# DATABASE_URL=postgresql+psycopg://jobagent:password@localhost:5432/jobagent

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Live job provider
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS requires a free API key and the email used to request it.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
USAJOBS_ORGANIZATION=AG11
USAJOBS_LOCATION=Sonora, California
USAJOBS_RADIUS=75

# demo | adzuna
JOB_PROVIDER=demo
